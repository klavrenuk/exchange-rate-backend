# App
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/db.sqlite3

# Data dirs
DATA_DIR=./data
REPORT_DIR=./data/reports
CHART_DIR=./data/charts

# Scheduler
SCHEDULER_ENABLED=true
TZ=Europe/Minsk
SCHED_NBRB_UPDATE_CRON=0 9 * * *
SCHED_REPORT_CRON=0 18 * * *
SCHED_IEA_CHECK_CRON=0 10 * * *

# NBRB
NBRB_API_BASE=https://api.nbrb.by
NBRB_HISTORY_FROM=2000-01-01
NBRB_LOAD_BATCH_DAYS=365

# IEA
IEA_CATALOG_URL=https://www.iea.org/data-and-statistics/charts
IEA_DOWNLOAD_SCREENSHOT=true
IEA_BROWSER=playwright

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_user
SMTP_PASSWORD=your_pass
SMTP_USE_TLS=true
SMTP_USE_SSL=false
MAIL_FROM=your_email@example.com
MAIL_TO=recipient1@example.com,recipient2@example.com
MAIL_DRY_RUN=true
MAIL_SUBJECT_PREFIX=[ExchangeRates]

# Misc
LOG_LEVEL=INFO
